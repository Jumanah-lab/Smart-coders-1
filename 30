a = float(input("Enter a: "))
b = float(input("Enter b: "))
op = input("Enter operator (+, -, *, /): ")

match op:
    case "+":
        print(a + b)

    case "-":
        print(a - b)

    case "*":
        print(a * b)

    case "/":
        if b != 0:
            print(a / b)
        else:
            print("Cannot divide by zero")

    case _:
        print("Invalid operator")